datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

model User {
  user_id           String   @id @default(uuid())
  student_id        String?  @unique @db.VarChar(50)
  name              String
  email             String   @unique
  password_hash     String
  role              String   // STUDENT, MENTOR, ADMIN
  department_id     Int?
  status            String   @default("ACTIVE") // ACTIVE, INACTIVE
  email_verified    Boolean  @default(false)
  profile_completed Boolean  @default(false)
  created_at        DateTime @default(now())

  department        Department?    @relation(fields: [department_id], references: [department_id])
  student_profile   StudentProfile?
  mentor_profile    MentorProfile?
  created_projects  Project[]      @relation("CreatedProjects")
  mentored_projects Project[]      @relation("MentoredProjects")
  team_memberships  TeamMember[]
  uploaded_docs     Document[]
  sent_messages     Message[]
  notifications     Notification[]
  audit_logs        AuditLog[]
  assigned_tasks    Task[]         @relation("AssignedTasks")
  created_tasks     Task[]         @relation("CreatedTasks")
  task_comments     TaskComment[]
  meetings_hosted   Meeting[]
  evaluations_given Evaluation[]
  join_requests     JoinRequest[]
}

model StudentProfile {
  user_id           String   @id
  year              String   @default("1st Year")
  phone             String   @default("")
  skills            String   // JSON string of array
  interests         String   // JSON string of array
  experience        String   @default("")
  availability      String   @default("Available")
  portfolio_links   String   // JSON string of array
  preferred_domains String   // JSON string of array

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
}

model MentorProfile {
  user_id            String   @id
  employee_id        String   @default("")
  designation        String   @default("Assistant Professor")
  expertise          String   @default("[]") // JSON string of array
  subjects_handled   String   @default("[]") // JSON string of array
  years_experience   Int      @default(0)
  skills             String   @default("[]") // JSON string of array
  research_interests String   @default("[]") // JSON string of array
  preferred_domains  String   @default("[]") // JSON string of array
  availability       String   @default("Available")
  mentoring_capacity Int      @default(5)
  current_load       Int      @default(0)

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
}

model Department {
  department_id   Int    @id @default(autoincrement())
  department_code String @default("") @db.VarChar(20)
  department_name String @unique @db.VarChar(100)
  status          String @default("ACTIVE")

  users           User[]
  target_projects Project[] @relation("TargetDepartmentProjects")
}

model Skill {
  skill_id   String @id @default(uuid())
  skill_name String @unique
}

model Project {
  project_id                 String   @id @default(uuid())
  project_code               String?  @unique
  title                      String
  abstract                   String
  problem_statement          String
  proposed_solution          String
  domain                     String
  description                String
  objectives                 String   // JSON string of array
  required_skills            String   // JSON string of array
  required_departments       String   // JSON string of array
  eligible_years             String   @default("[]") // JSON string of array
  target_department_id       Int?
  team_size                  Int      @default(4)
  technologies               String   // JSON string of array
  hardware_requirements      String   @default("None")
  expected_outcome           String
  duration                   String   @default("1 Semester")
  difficulty_level           String   @default("Intermediate")
  preferred_mentor_expertise String   // JSON string of array
  status                     String   @default("PENDING") // PENDING, PUBLISHED, REJECTED, ARCHIVED, COMPLETED
  created_by                 String
  mentor_id                  String?
  created_at                 DateTime @default(now())

  creator             User                @relation("CreatedProjects", fields: [created_by], references: [user_id], onDelete: Cascade)
  mentor              User?               @relation("MentoredProjects", fields: [mentor_id], references: [user_id], onDelete: SetNull)
  target_department   Department?         @relation("TargetDepartmentProjects", fields: [target_department_id], references: [department_id], onDelete: SetNull)
  team                Team?
  mentorship_requests MentorshipRequest[]
  join_requests       JoinRequest[]
  milestones          Milestone[]
  documents           Document[]
  messages            Message[]
  tasks               Task[]
  meetings            Meeting[]
  evaluations         Evaluation[]
}

model JoinRequest {
  request_id   String   @id @default(uuid())
  project_id   String
  student_id   String
  status       String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  notes        String   @default("")
  created_at   DateTime @default(now())

  project Project @relation(fields: [project_id], references: [project_id], onDelete: Cascade)
  student User    @relation(fields: [student_id], references: [user_id], onDelete: Cascade)

  @@unique([project_id, student_id])
}

model Team {
  team_id    String   @id @default(uuid())
  team_code  String?  @unique
  project_id String   @unique
  status     String   @default("ACTIVE")
  created_at DateTime @default(now())

  project Project      @relation(fields: [project_id], references: [project_id], onDelete: Cascade)
  members TeamMember[]
}

model TeamMember {
  team_id    String
  student_id String
  role       String   @default("Member") // Leader, Member
  joined_at  DateTime @default(now())

  team    Team @relation(fields: [team_id], references: [team_id], onDelete: Cascade)
  student User @relation(fields: [student_id], references: [user_id], onDelete: Cascade)

  @@id([team_id, student_id])
}

model MentorshipRequest {
  request_id    String   @id @default(uuid())
  project_id    String
  mentor_id     String
  status        String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  response_note String   @default("")
  requested_at  DateTime @default(now())

  project Project @relation(fields: [project_id], references: [project_id], onDelete: Cascade)
}

model Milestone {
  milestone_id     String    @id @default(uuid())
  project_id       String
  title            String
  deadline         String
  status           String    @default("PENDING") // PENDING, SUBMITTED, IN_REVIEW, APPROVED, REVISION_REQUESTED
  submission_url   String    @default("")
  submission_notes String    @default("")
  feedback         String    @default("")
  rating           Int       @default(0)
  approved_by      String    @default("")
  submitted_at     DateTime?

  project Project @relation(fields: [project_id], references: [project_id], onDelete: Cascade)
}

model Document {
  document_id   String   @id @default(uuid())
  project_id    String
  title         String
  uploaded_by   String
  file_location String
  version       String   @default("v1.0")
  file_size     Int      @default(0)
  created_at    DateTime @default(now())

  project  Project @relation(fields: [project_id], references: [project_id], onDelete: Cascade)
  uploader User    @relation(fields: [uploaded_by], references: [user_id], onDelete: Cascade)
}

model Message {
  message_id String   @id @default(uuid())
  sender_id  String
  project_id String
  content    String
  created_at DateTime @default(now())

  project Project @relation(fields: [project_id], references: [project_id], onDelete: Cascade)
  sender  User    @relation(fields: [sender_id], references: [user_id], onDelete: Cascade)
}

model Notification {
  notification_id String   @id @default(uuid())
  user_id         String
  type            String   // PROJECT_INVITE, PROJECT_ACCEPT, PROJECT_REJECT, TASK, MILESTONE, MENTORSHIP, SYSTEM
  message         String
  project_id      String?
  status          String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  read            Boolean  @default(false)
  created_at      DateTime @default(now())

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
}

model AuditLog {
  log_id      String   @id @default(uuid())
  user_id     String
  action      String
  target_type String
  target_id   String
  details     String   @default("")
  timestamp   DateTime @default(now())

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
}

model OtpVerification {
  id         String   @id @default(uuid())
  email      String   @unique
  otp_code   String
  role       String   @default("STUDENT")
  expires_at DateTime
  created_at DateTime @default(now())
}

model PendingRegistration {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  password_hash String
  role          String
  department_id Int
  student_id    String?
  year          String?
  phone         String?
  skills        String?
  interests     String?
  otp_code      String
  expires_at    DateTime
  created_at    DateTime @default(now())
}

model SystemSetting {
  key        String   @id
  value      String
  updated_at DateTime @default(now())
}

model Task {
  task_id     String   @id @default(uuid())
  project_id  String
  title       String
  description String   @default("")
  assigned_to String?
  created_by  String
  status      String   @default("TODO") // TODO, IN_PROGRESS, IN_REVIEW, COMPLETED
  priority    String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  due_date    String?
  created_at  DateTime @default(now())

  project  Project       @relation(fields: [project_id], references: [project_id], onDelete: Cascade)
  assignee User?         @relation("AssignedTasks", fields: [assigned_to], references: [user_id], onDelete: SetNull)
  creator  User          @relation("CreatedTasks", fields: [created_by], references: [user_id], onDelete: Cascade)
  comments TaskComment[]
}

model TaskComment {
  comment_id String   @id @default(uuid())
  task_id    String
  user_id    String
  comment    String
  created_at DateTime @default(now())

  task Task @relation(fields: [task_id], references: [task_id], onDelete: Cascade)
  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
}

model Meeting {
  meeting_id     String   @id @default(uuid())
  project_id     String
  meeting_number Int      @default(1)
  title          String
  description    String   @default("")
  scheduled_at   DateTime
  location       String   @default("Online")
  meet_link      String   @default("")
  host_id        String
  created_at     DateTime @default(now())

  project Project @relation(fields: [project_id], references: [project_id], onDelete: Cascade)
  host    User    @relation(fields: [host_id], references: [user_id], onDelete: Cascade)
}

model Evaluation {
  evaluation_id String   @id @default(uuid())
  project_id    String
  evaluator_id  String
  score         Float
  feedback      String   @default("")
  rubric_scores String   @default("{}")
  created_at    DateTime @default(now())

  project   Project @relation(fields: [project_id], references: [project_id], onDelete: Cascade)
  evaluator User    @relation(fields: [evaluator_id], references: [user_id], onDelete: Cascade)
}

model ProjectCounter {
  id       Int @id @default(1)
  last_val Int @default(0)
}
